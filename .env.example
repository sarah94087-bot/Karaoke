# Copy to .env and fill in. .env is gitignored and must never be pasted into chat.

# Groq — transcription (D-27). console.groq.com
GROQ_API_KEY=

# Backblaze B2 — object storage (D-12), spoken to over the S3 API. secure.backblaze.com
# R2 was rejected in T-0.6: its free tier is behind a payment method.
# Endpoint and region are on the bucket's page; the key pair is an application key.
KARUKI_S3_ENDPOINT=
KARUKI_S3_BUCKET=karuki
KARUKI_S3_REGION=
KARUKI_S3_KEY_ID=
KARUKI_S3_SECRET=

# Supabase — database and auth (D-15, D-16). supabase.com, free tier, no card.
# The URL and the publishable/anon key are browser-safe; scripts/web_env.py
# copies them into apps/web/.env.local. Nothing else here is.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# The *Session pooler* string from Connect, not the direct one: direct is
# IPv6-only and free hosts dial out over IPv4. Deliberately not DATABASE_URL -
# that name belongs to the local Postgres, and the test suite drops every table.
SUPABASE_DATABASE_URL=

# Modal needs nothing here: `modal setup` stores credentials in ~/.modal.toml

# --- API service (T-1.2). Not secrets; all have working local defaults. ---

# Reported by /system/health and shown in the OpenAPI document.
KARUKI_VERSION=0.1.0

# "local" or "production". Chapter 10: there is no staging.
KARUKI_ENV=local

# Comma-separated browser origins allowed to call the API.
KARUKI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set by docker compose for you. Only needed when running uvicorn straight off
# the venv against a database you started yourself.
DATABASE_URL=postgresql://karuki:karuki@localhost:5432/karuki

# Where separation runs: "local" (Demucs on the CPU - slow, free) or "modal"
# (the serverless GPU from T-0.3, which spends the $1/month credit).
KARUKI_SEPARATION_BACKEND=local

# The open synchronised-lyrics database (T-2.2): "lrclib" or "none".
KARUKI_LYRICS_CATALOGUE=lrclib

# Transcription (T-2.3): "groq" or "none". Needs GROQ_API_KEY above.
KARUKI_TRANSCRIPTION_BACKEND=groq

# Where objects live (T-3.1): "local" (a directory) or "s3" (the bucket above).
KARUKI_STORAGE_BACKEND=local
KARUKI_STORAGE_ROOT=var/storage

# How long a signed file link lives, in seconds.
KARUKI_SIGNED_URL_TTL=3600

# What the local backend signs links with. Unset means a fresh random secret per
# process, so links stop working on restart - fine locally, set it on a deploy.
KARUKI_SIGNING_SECRET=

# Prepended to local signed links. Empty gives a root-relative URL, which is
# what the web app resolves against whichever host it reached the API on.
KARUKI_PUBLIC_BASE_URL=

# Where the web app looks for the API. Copied into apps/web/.env.local by
# scripts/web_env.py, and **baked into the bundle at build time** - chapter 14's
# second named mistake is changing this and only restarting. Empty is fine
# locally; api.ts falls back to http://127.0.0.1:8000/api/v1.
KARUKI_API_BASE=

# --- deployment (T-3.10). Values live in the platform, never here. ---
#
# Render reads render.yaml and asks for every `sync: false` variable once.
# Vercel needs NEXT_PUBLIC_API_BASE and the two NEXT_PUBLIC_SUPABASE_* values.
#
# MODAL_TOKEN_ID / MODAL_TOKEN_SECRET: the API calls the GPU function from a
# container that has no ~/.modal.toml. Create them with `modal token new` and
# put them in Render.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Log level for the API's root logger. INFO is what makes the GPU cost line and
# the startup notices visible at all - uvicorn leaves the root at WARNING.
KARUKI_LOG_LEVEL=INFO

# Largest upload accepted, in bytes. Checked as the bytes arrive and again on
# the object that actually landed in the bucket (T-3.2), never from a claim.
KARUKI_MAX_UPLOAD_BYTES=83886080

# Who a request belongs to when no identity provider is configured. Chapter 11's
# "runs on a machine with no accounts on it" rests on this; production refuses
# to start without SUPABASE_URL, so it never applies there.
KARUKI_DEV_USER_ID=

# Seconds before giving up on the open lyrics database and on the transcription
# service. Both are "no words", never a failed job.
KARUKI_LYRICS_TIMEOUT=
KARUKI_TRANSCRIPTION_TIMEOUT=

# --- error tracking (D-24, T-3.12) ---
#
# Two Sentry projects, because an error in the API and an error in a browser are
# different incidents. Empty means errors are logged and reported nowhere, which
# is the normal local state. The browser DSN is public by design - it is
# compiled into the bundle - and scripts/web_env.py copies it across.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Guards GET /system/error, chapter 14's deliberate error. Unset means that
# route answers 404, so forgetting it fails safe. Render generates the value.
KARUKI_ERROR_PROBE_TOKEN=

# Shown on browser error reports so an issue can be tied to a build. Optional.
NEXT_PUBLIC_RELEASE=

# --- written by scripts/web_env.py into apps/web/.env.local, not read here ---
#
# Listed so this file stays the full inventory: these are the names the *web*
# app reads, and they are baked into its bundle at build time.
# NEXT_PUBLIC_SUPABASE_URL
# NEXT_PUBLIC_SUPABASE_ANON_KEY

# Guards POST /system/reap, chapter 9's retention pass run from outside on a
# schedule (T-3.13). Its own token and not the probe's: that route raises an
# error, this one deletes audio. Render generates the value; the same value
# goes in the repository's Actions secrets, which is what calls it.
KARUKI_MAINTENANCE_TOKEN=

# --- the post-deploy smoke test (scripts/smoke.py, T-3.13) ---
#
# Only needed to run the checks that require a session. The password belongs in
# the environment of whoever is running the check and nowhere else - not here,
# not in a command line that lands in a shell history.
KARUKI_SMOKE_EMAIL=
KARUKI_SMOKE_PASSWORD=
# Override the addresses the smoke test asks. Default: the deployed pair.
KARUKI_SMOKE_API=
KARUKI_SMOKE_WEB=
